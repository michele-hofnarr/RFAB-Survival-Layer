# Binaries: no EOL conversion, no diff noise.
*.pex   binary
*.swf   binary
*.esp   binary

# MCM translations are UTF-16LE with BOM. Git must not touch them.
Interface/Translations/*.txt -text

# Autogenerated Papyrus - no EOL conversion (_RSL_Forms.psc is CP1251/ANSI).
scripts/source/_RSL_Forms.psc -text
scripts/source/_RSL_Balance.psc -text

# Generator scripts stay UTF-8 in the repo; deploy.sh writes CP1251 copies.
*.pas   text
