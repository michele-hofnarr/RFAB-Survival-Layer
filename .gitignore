# Editors / OS
.vscode/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
.DS_Store

# MO2 local state (rewritten by the manager)
meta.ini

# Build artifacts - reproduced from source, uploaded straight to a GitHub
# Release (see RELEASING.md), not tracked:
#   .pex   <- _build.bat from scripts/source/*.psc  (only _RSL_MCM is left)
#   .swf   <- tools/make_assets_swf.py from widget/icons + widget/generated
#   .dll   <- cmake --build native/build
#   .bin   <- tools/bake_climate.py from Skyrim.esm + control_points.xlsx
#
# RFAB_SurvivalLayer.esp IS tracked, and it is the odd one out on purpose.
# The generator edits the plugin that is there rather than building one from
# nothing, and that is the only reason a record keeps its FormID between
# releases. Lose the file and every id is reassigned - which a player's save
# cannot follow. Eighty kilobytes to make that impossible to lose.
scripts/*.pex
SKSE/Plugins/_RSL_Core.dll
SKSE/Plugins/_RSL_Climate.bin
*.esp.old
*.esp.save*
*.bak
Interface/**/*.swf
widget/*.swf

# Native plugin build scratch and vcpkg's per-project install tree
native/build/
native/vcpkg_installed/

# Widget design previews - regenerated by tools/widget_design.py
widget/design/
SKSE/Plugins/_RSL_Core.pdb
__pycache__/

# Climate renders and the marker dump are regenerated by
# tools/bake_climate.py, tools/draw_baked.py and tools/control_points.py.
# The workbook itself IS tracked - it holds the hand-set temperatures and
# nothing else can reproduce those.
# Renders are rebuilt by tools/draw_baked.py, so they are not tracked - except
# the one the README shows, which has to be in the repository to be seen.
docs/img/*
!docs/img/baked_tamriel.png
docs/control_points.txt
docs/control_points(copy).xlsx
